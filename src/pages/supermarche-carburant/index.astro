---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import brandsData from '../../data/fr_brands.json';

const supermarchés = brandsData.filter(b => b.category === 'Supermarché');
---

<Layout
  title="Carburant en Grande Surface — E.Leclerc, Carrefour, Intermarché, Système U, Auchan"
  description="Comparez les prix des carburants dans les grandes surfaces en France. Découvrez quelle enseigne propose le gazole et l'essence les moins chers entre Leclerc, Intermarché et Carrefour."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-950/80 border border-blue-800 text-blue-300 mb-4">
        <span>🛒 GRANDE DISTRIBUTION & PRIX BAS</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Carburant en Grande Surface : Qui est le Moins Cher ?
      </h1>
      <p class="mt-4 text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Les stations de supermarchés représentent plus de 60 % des volumes de carburant distribués en France. Retrouvez ici les fiches détaillées de chaque enseigne.
      </p>
    </header>

    <AdSlot />

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 my-12">
      {supermarchés.map(b => (
        <a
          href={`/enseigne/${b.slug}/`}
          class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 hover:border-blue-500/60 hover:bg-zinc-900 transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="w-3 h-3 rounded-full mb-3" style={`background-color: ${b.color}`}></div>
            <h2 class="text-xl font-black text-white group-hover:text-blue-400 transition-colors">{b.name}</h2>
            <p class="text-xs text-zinc-400 mt-2">
              Stations-service {b.name} avec prix du gazole, SP95-E10, SP98 et opérations prix coûtant.
            </p>
          </div>
          <div class="mt-6 text-xs font-bold text-blue-400 flex items-center gap-1">
            <span>Voir les stations {b.name}</span> &rarr;
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
