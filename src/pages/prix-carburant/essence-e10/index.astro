---
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import citiesData from '../../../data/fr_cities.json';

const topCities = citiesData.slice(0, 48);
---

<Layout
  title="Prix du SP95-E10 en France — Essence Sans Plomb au Meilleur Prix"
  description="Comparez les tarifs du SP95-E10 en temps réel dans toute la France. Trouvez les stations essence les plus économiques pour faire le plein de votre véhicule essence."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-zinc-900 border border-zinc-800 text-zinc-300 mb-4">
        <span>🟢 ESSENCE SANS PLOMB 95-E10</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Prix du <span class="text-blue-400">SP95-E10</span> en Direct
      </h1>
      <p class="mt-4 text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        L'essence la plus vendue en France. Comparez les prix déclarés par les gérants de stations sur la plateforme du Ministère de l'Économie.
      </p>
    </header>

    <AdSlot />

    <section class="mt-12">
      <h2 class="text-xl font-black text-white mb-6">
        Prix du SP95-E10 par Commune
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {topCities.map(c => (
          <a
            href={`/prix-carburant/${c.slug}/essence-e10/`}
            class="p-3 bg-zinc-900 border border-zinc-800 hover:border-blue-500/60 rounded-xl transition-all group block shadow-sm"
          >
            <div class="text-xs font-bold text-white group-hover:text-blue-400 transition-colors truncate">
              {c.name}
            </div>
            <div class="text-[10px] text-zinc-500 mt-1 truncate">
              {c.deptName}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
