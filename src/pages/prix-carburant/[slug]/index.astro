---
import Layout from '../../../layouts/Layout.astro';
import CityDetail from '../../../components/CityDetail.astro';
import citiesData from '../../../data/fr_cities.json';

export async function getStaticPaths() {
  return citiesData.map(city => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
---

<Layout
  title={`Prix des Carburants à ${city.name} (${city.deptCode}) — Comparateur Station la Moins Chère`}
  description={`Tous les prix de l'essence et du gazole à ${city.name} (${city.deptName}). Comparez les stations E.Leclerc, TotalEnergies, Carrefour, Intermarché pour faire votre plein au meilleur prix.`}
>
  <CityDetail city={city} />
</Layout>
