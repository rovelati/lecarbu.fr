---
import Layout from '../../../layouts/Layout.astro';
import CityDetail from '../../../components/CityDetail.astro';
import citiesData from '../../../data/fr_cities.json';

export async function getStaticPaths() {
  return citiesData.map(city => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
---

<Layout
  title={`Prix SP95-E10 à ${city.name} (${city.deptCode}) — Essence Sans Plomb la Moins Chère`}
  description={`Comparez les prix de l'essence SP95-E10 à ${city.name} (${city.deptName}). Localisez les stations essence les plus économiques près de chez vous en direct.`}
>
  <CityDetail city={city} fuelFilter="e10" />
</Layout>
