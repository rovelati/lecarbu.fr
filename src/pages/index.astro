---
/**
 * index.astro — LeCarbu.fr Homepage
 * Real-time French fuel price comparator powered by official Ministry of Economy Open Data.
 */
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import citiesData from '../data/fr_cities.json';
import brandsData from '../data/fr_brands.json';
import deptData from '../data/fr_departements.json';

const topMetropoles = [
  'paris', 'marseille', 'lyon', 'toulouse', 'nice', 'nantes', 'montpellier', 'strasbourg',
  'bordeaux', 'lille', 'rennes', 'reims', 'saint-etienne', 'toulon', 'le-havre', 'grenoble',
  'dijon', 'angers', 'nimes', 'villeurbanne', 'clermont-ferrand', 'le-mans', 'aix-en-provence',
  'brest', 'tours', 'amiens', 'limoges', 'annecy', 'perpignan', 'boulogne-billancourt',
  'metz', 'besancon', 'orleans', 'saint-denis', 'argenteuil', 'rouen', 'montreuil', 'mulhouse',
  'caen', 'nancy', 'tourcoing', 'roubaix', 'nanterre', 'vitry-sur-seine', 'avignon', 'creteil',
  'poitiers', 'dunkerque'
];

const featuredCities = citiesData
  .filter(c => topMetropoles.includes(c.slug))
  .slice(0, 48);

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const citiesByLetter: Record<string, typeof citiesData> = {};
for (const letter of alphabet) {
  citiesByLetter[letter] = citiesData.filter(c => c.name.toUpperCase().startsWith(letter)).slice(0, 40);
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'LeCarbu.fr',
  'url': 'https://lecarbu.fr/',
  'description': 'Comparateur officiel des prix des carburants en France (Gazole, SP95-E10, SP98, E85). Données ouvertes du Ministère de l\'Économie.',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': {
      '@type': 'EntryPoint',
      'urlTemplate': 'https://lecarbu.fr/prix-carburant/{search_term_string}/'
    },
    'query-input': 'required name=search_term_string'
  }
};
---

<Layout
  title="LeCarbu.fr — Prix des Carburants en Temps Réel en France"
  description="Trouvez la station essence la moins chère aujourd'hui en France (Gazole, SP95-E10, SP98, E85). Comparez plus de 9 800 stations E.Leclerc, TotalEnergies, Carrefour, Intermarché avec les données officielles du Ministère."
  schema={websiteSchema}
>
  <!-- Hero Section with French Tricolor Highlights -->
  <section class="relative overflow-hidden border-b border-zinc-800 bg-gradient-to-b from-blue-950/20 via-zinc-950 to-zinc-950 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-blue-950/80 border border-blue-800/80 text-blue-300 mb-6 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>DONNÉES OFFICIELLES DU MINISTÈRE DE L'ÉCONOMIE • DIRECT 2026</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white leading-tight">
        Faites votre plein au <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-red-400 bg-clip-text text-transparent">meilleur prix</span> partout en France.
      </h1>

      <p class="mt-4 text-base sm:text-lg text-zinc-300 max-w-2xl mx-auto leading-relaxed">
        Comparez les prix de plus de <strong class="text-white">9 800 stations-service</strong> en temps réel. Économisez jusqu'à 15 € par plein sur le Gazole, le SP95-E10, le SP98 et le Superéthanol E85.
      </p>

      <!-- Search Input Container -->
      <div id="search-container" class="mt-8 max-w-xl mx-auto">
        <div class="relative flex items-center">
          <input
            type="text"
            id="city-search-input"
            placeholder="Entrez votre ville ou code postal (ex. Lyon, 33000, Nantes)..."
            class="w-full px-5 py-4 pl-12 rounded-2xl bg-zinc-900 border-2 border-zinc-700/80 text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-blue-500 transition-all shadow-2xl"
            autocomplete="off"
          />
          <svg class="w-5 h-5 text-zinc-400 absolute left-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            id="geo-btn"
            title="Me géolocaliser"
            class="absolute right-3 px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all flex items-center gap-1 shadow-md shadow-blue-500/30"
          >
            <span>Autour de moi</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>

        <!-- Search Autocomplete Results -->
        <div id="search-results" class="hidden mt-2 p-2 rounded-xl bg-zinc-900 border border-zinc-800 text-left text-sm max-h-64 overflow-y-auto shadow-2xl z-50"></div>
      </div>

      <!-- Fuel Quick Links Bar -->
      <div class="mt-8 flex items-center justify-center gap-3 flex-wrap text-xs">
        <span class="text-zinc-500 font-semibold">Tendances :</span>
        <a href="/prix-carburant/gazole/" class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-blue-500/60 transition-colors">
          Gazole (Diesel)
        </a>
        <a href="/prix-carburant/essence-e10/" class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-blue-500/60 transition-colors">
          SP95-E10
        </a>
        <a href="/prix-carburant/sp98/" class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-blue-500/60 transition-colors">
          SP98
        </a>
        <a href="/prix-carburant/e85/" class="px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800 text-emerald-300 hover:text-white hover:border-emerald-600 transition-colors font-semibold">
          E85 Bioéthanol (0.85€)
        </a>
      </div>
    </div>
  </section>

  <!-- Top Métropoles Grid -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-white">
          Prix Carburant dans les Grandes Métropoles
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1">
          Accès rapide aux stations les moins chères dans les 48 plus grandes villes de France
        </p>
      </div>
      <a href="/carburant-moins-cher/" class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-blue-400 hover:text-blue-300">
        <span>Toutes les stations</span> &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {featuredCities.map(city => (
        <a
          href={`/prix-carburant/${city.slug}/`}
          class="p-3 bg-zinc-900 border border-zinc-800 hover:border-blue-500/60 rounded-xl transition-all group block shadow-sm"
        >
          <div class="text-sm font-bold text-white group-hover:text-blue-400 transition-colors truncate">
            {city.name}
          </div>
          <div class="text-[11px] text-zinc-500 truncate flex items-center justify-between mt-1">
            <span>{city.deptName}</span>
            {city.minGazole && (
              <span class="text-emerald-400 font-semibold">{city.minGazole.toFixed(2)}€</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Ad Slot Top -->
  <section class="max-w-6xl mx-auto px-4">
    <AdSlot />
  </section>

  <!-- Supermarkets & Oil Brands Section -->
  <section class="max-w-7xl mx-auto px-4 py-12 border-t border-zinc-900">
    <div class="mb-8 text-center max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-white">
        Prix des Carburants par Enseigne
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Comparez les prix entre la grande distribution et les grands réseaux pétroliers
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {brandsData.map(b => (
        <a
          href={`/enseigne/${b.slug}/`}
          class="p-5 rounded-2xl border border-zinc-800 bg-zinc-900/60 hover:border-blue-500/60 hover:bg-zinc-900 transition-all group"
        >
          <div class="flex items-center gap-2 mb-2">
            <span class="w-3 h-3 rounded-full" style={`background-color: ${b.color}`}></span>
            <span class="text-[10px] uppercase font-bold text-zinc-400">{b.category}</span>
          </div>
          <div class="text-lg font-black text-white group-hover:text-blue-400 transition-colors">
            {b.name}
          </div>
          <div class="text-xs text-zinc-400 mt-1">
            Stations en France &rarr;
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Departments Directory -->
  <section class="max-w-7xl mx-auto px-4 py-12 border-t border-zinc-900">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white">
        Prix par Département
      </h2>
      <p class="text-xs text-zinc-400 mt-1">
        Trouvez la station la moins chère dans votre département métropolitain
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 text-xs">
      {deptData.slice(0, 96).map(d => (
        <a
          href={`/departement/${d.slug}/`}
          class="p-2.5 rounded-lg bg-zinc-900/40 border border-zinc-800/80 hover:border-blue-500/50 hover:text-blue-300 transition-colors truncate"
        >
          <span class="font-bold text-zinc-400">{d.code}</span> — {d.name}
        </a>
      ))}
    </div>
  </section>

  <!-- A-Z Directory of all 3,000 Communes for Google SEO crawlability -->
  <section class="max-w-7xl mx-auto px-4 py-12 border-t border-zinc-900">
    <div class="mb-6">
      <h2 class="text-xl font-black text-white">
        Répertoire National des Communes (A — Z)
      </h2>
      <p class="text-xs text-zinc-400 mt-1">
        Accédez aux prix des carburants dans toutes les communes de France
      </p>
    </div>

    <div class="space-y-6">
      {alphabet.map(letter => {
        const letterCities = citiesByLetter[letter];
        if (!letterCities || letterCities.length === 0) return null;
        return (
          <div class="border-b border-zinc-900/80 pb-4">
            <div class="text-sm font-black text-blue-400 mb-2">{letter}</div>
            <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs">
              {letterCities.map(c => (
                <a
                  href={`/prix-carburant/${c.slug}/`}
                  class="text-zinc-400 hover:text-white transition-colors"
                >
                  {c.name}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const input = document.getElementById('city-search-input');
    const results = document.getElementById('search-results');
    const geoBtn = document.getElementById('geo-btn');

    if (!input || !results) return;

    let cities = [];
    fetch('/fr_stations_index.json')
      .then(r => r.json())
      .then(data => {
        const seen = new Set();
        data.forEach(s => {
          if (!seen.has(s.c)) {
            seen.add(s.c);
            cities.push({ slug: s.c, name: s.v, cp: s.cp, dept: s.d, lat: s.lt, lng: s.lg });
          }
        });
      });

    input.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      if (q.length < 2) {
        results.classList.add('hidden');
        return;
      }
      const matches = cities
        .filter(c => c.name.toLowerCase().includes(q) || c.cp.startsWith(q))
        .slice(0, 8);

      if (matches.length === 0) {
        results.innerHTML = '<div class="p-3 text-zinc-400 text-xs">Aucune commune trouvée.</div>';
        results.classList.remove('hidden');
        return;
      }

      results.innerHTML = matches.map(c => `
        <a href="/prix-carburant/${c.slug}/" class="block p-2.5 rounded-lg hover:bg-zinc-800 text-zinc-200 transition-colors flex items-center justify-between">
          <div>
            <span class="font-bold text-white">${c.name}</span>
            <span class="text-xs text-zinc-400 ml-1">(${c.cp})</span>
          </div>
          <span class="text-xs text-blue-400 font-semibold">Voir les prix &rarr;</span>
        </a>
      `).join('');
      results.classList.remove('hidden');
    });

    if (geoBtn && 'geolocation' in navigator) {
      geoBtn.addEventListener('click', () => {
        geoBtn.innerHTML = '<span>Recherche...</span>';
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const userLat = pos.coords.latitude;
            const userLng = pos.coords.longitude;
            let nearest = null;
            let minDist = 99999;
            cities.forEach(c => {
              const dLat = c.lat - userLat;
              const dLng = c.lng - userLng;
              const dist = dLat*dLat + dLng*dLng;
              if (dist < minDist) {
                minDist = dist;
                nearest = c;
              }
            });
            if (nearest) {
              window.location.href = `/prix-carburant/${nearest.slug}/`;
            }
          },
          (err) => {
            alert('Impossible de vous géolocaliser. Veuillez entrer votre ville manuellement.');
            geoBtn.innerHTML = '<span>Autour de moi</span>';
          }
        );
      });
    }
  })();
</script>
