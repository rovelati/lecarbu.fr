---
/**
 * CityDetail.astro — LeCarbu.fr
 * Renders the city fuel comparison page with interactive Leaflet map,
 * sorted price cards, cheapest station badges, nearby cities interlinking,
 * department overview, expert fuel savings tips, and Schema.org GasStation data.
 */
import AdSlot from './AdSlot.astro';
import citiesData from '../data/fr_cities.json';
import deptData from '../data/fr_departements.json';
import brandsData from '../data/fr_brands.json';

interface Props {
  city: {
    name: string;
    slug: string;
    deptCode: string;
    deptName: string;
    regionName: string;
    lat: number;
    lng: number;
    stationCount: number;
    minGazole?: number | null;
    minE10?: number | null;
    minSP98?: number | null;
    minE85?: number | null;
  };
  fuelFilter?: 'gazole' | 'e10' | 'sp98' | 'e85' | null;
}

const { city, fuelFilter = null } = Astro.props;

const fuelNames: Record<string, string> = {
  gazole: 'Gazole (Diesel)',
  e10: 'SP95-E10',
  sp98: 'SP98 Super',
  e85: 'E85 Bioéthanol',
};

const activeFuelName = fuelFilter ? fuelNames[fuelFilter] : null;

const pageTitle = fuelFilter
  ? `Prix ${activeFuelName} à ${city.name} (${city.deptCode}) — Comparateur LeCarbu.fr`
  : `Prix des Carburants à ${city.name} (${city.deptCode}) — Comparateur Station la Moins Chère`;

const pageDesc = fuelFilter
  ? `Comparez les prix du ${activeFuelName} à ${city.name} (${city.deptName}). Trouvez la station-service la moins chère aujourd'hui grâce aux données officielles du Ministère.`
  : `Tous les prix de l'essence et du gazole à ${city.name} (${city.deptName}). Comparez les stations E.Leclerc, TotalEnergies, Carrefour, Intermarché pour faire votre plein au meilleur prix.`;

const currentDept = (deptData as any[]).find(d => d.code === city.deptCode);
const deptSlug = currentDept ? currentDept.slug : `${city.deptCode.toLowerCase()}-${city.deptName.toLowerCase()}`;

// Haversine distance
function getDistKm(lat1: number, lon1: number, lat2: number, lon2: number) {
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
  return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// Bounding box filter for instant build speed
const boxLat = 0.40;
const boxLng = 0.50;
let candidates = (citiesData as any[]).filter(c =>
  c.slug !== city.slug &&
  Math.abs(c.lat - city.lat) < boxLat &&
  Math.abs(c.lng - city.lng) < boxLng
);
if (candidates.length < 6) {
  candidates = (citiesData as any[]).filter(c => c.slug !== city.slug);
}

const nearbyCities = candidates
  .map(c => ({
    ...c,
    distKm: getDistKm(city.lat, city.lng, c.lat, c.lng),
  }))
  .sort((a, b) => a.distKm - b.distKm)
  .slice(0, 9);

// Department main cities (excluding current city)
const deptMainCities = (citiesData as any[])
  .filter(c => c.deptCode === city.deptCode && c.slug !== city.slug)
  .slice(0, 10);

// Neighboring departments in the same region
const regionDepts = (deptData as any[])
  .filter(d => d.region === city.regionName && d.code !== city.deptCode)
  .slice(0, 6);
---

<div class="max-w-7xl mx-auto px-4 py-8">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-zinc-400 mb-6 flex-wrap" aria-label="Fil d'Ariane">
    <a href="/" class="hover:text-blue-400 transition-colors">Accueil</a>
    <span>/</span>
    <a href={`/departement/${deptSlug}/`} class="hover:text-blue-400 transition-colors">
      {city.deptName} ({city.deptCode})
    </a>
    <span>/</span>
    <a href={`/prix-carburant/${city.slug}/`} class={`hover:text-blue-400 transition-colors ${!fuelFilter ? 'text-white font-semibold' : ''}`}>
      {city.name}
    </a>
    {fuelFilter && (
      <>
        <span>/</span>
        <span class="text-white font-semibold">{activeFuelName}</span>
      </>
    )}
  </nav>

  <!-- Title & Key Metrics Header -->
  <header class="mb-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-950/80 text-blue-300 border border-blue-800/60 mb-3">
          <span>📍 {city.deptName} ({city.deptCode})</span>
          <span>•</span>
          <span>{city.regionName}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
          {fuelFilter ? (
            <>Prix du <span class="text-blue-400">{activeFuelName}</span> à {city.name}</>
          ) : (
            <>Prix des Carburants à <span class="text-blue-400">{city.name}</span></>
          )}
        </h1>
        <p class="mt-2 text-sm text-zinc-400 max-w-3xl leading-relaxed">
          {pageDesc}
        </p>
      </div>

      <!-- Quick Summary Pills -->
      <div class="flex items-center gap-3 flex-wrap">
        {city.minGazole && (
          <div class="px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-left">
            <div class="text-[10px] uppercase font-bold text-zinc-400">Gazole dès</div>
            <div class="text-lg font-black text-emerald-400">{city.minGazole.toFixed(3)} €</div>
          </div>
        )}
        {city.minE10 && (
          <div class="px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-left">
            <div class="text-[10px] uppercase font-bold text-zinc-400">SP95-E10 dès</div>
            <div class="text-lg font-black text-emerald-400">{city.minE10.toFixed(3)} €</div>
          </div>
        )}
        {city.minSP98 && (
          <div class="px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-left">
            <div class="text-[10px] uppercase font-bold text-zinc-400">SP98 dès</div>
            <div class="text-lg font-black text-blue-400">{city.minSP98.toFixed(3)} €</div>
          </div>
        )}
        {city.minE85 && (
          <div class="px-3 py-2 rounded-xl bg-zinc-900 border border-emerald-900/60 text-left">
            <div class="text-[10px] uppercase font-bold text-emerald-400">E85 dès</div>
            <div class="text-lg font-black text-emerald-400">{city.minE85.toFixed(3)} €</div>
          </div>
        )}
      </div>
    </div>

    <!-- Fuel Filter Pills -->
    <div class="flex items-center gap-2 mt-6 overflow-x-auto pb-2 scrollbar-none">
      <a
        href={`/prix-carburant/${city.slug}/`}
        class={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${
          !fuelFilter
            ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20'
            : 'bg-zinc-900 text-zinc-300 border border-zinc-800 hover:border-zinc-700'
        }`}
      >
        Tous les carburants
      </a>
      <a
        href={`/prix-carburant/${city.slug}/gazole/`}
        class={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${
          fuelFilter === 'gazole'
            ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20'
            : 'bg-zinc-900 text-zinc-300 border border-zinc-800 hover:border-zinc-700'
        }`}
      >
        Gazole (Diesel)
      </a>
      <a
        href={`/prix-carburant/${city.slug}/essence-e10/`}
        class={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${
          fuelFilter === 'e10'
            ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20'
            : 'bg-zinc-900 text-zinc-300 border border-zinc-800 hover:border-zinc-700'
        }`}
      >
        SP95-E10
      </a>
      <a
        href={`/prix-carburant/${city.slug}/sp98/`}
        class={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${
          fuelFilter === 'sp98'
            ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20'
            : 'bg-zinc-900 text-zinc-300 border border-zinc-800 hover:border-zinc-700'
        }`}
      >
        SP98 Super
      </a>
    </div>
  </header>

  <!-- Ad Slot Top -->
  <AdSlot />

  <!-- Interactive Map Section -->
  <section class="mb-10">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900 overflow-hidden shadow-2xl">
      <div class="p-4 border-b border-zinc-800/80 bg-zinc-900/90 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-ping"></span>
          <span class="text-xs font-bold text-white uppercase tracking-wider">
            Carte Interactive des Stations — {city.name}
          </span>
        </div>
        <span class="text-xs text-zinc-400">Cliquez sur un repère pour voir les tarifs</span>
      </div>
      <div id="city-map" class="w-full h-80 sm:h-96 z-10" data-lat={city.lat} data-lng={city.lng} data-city={city.slug}></div>
    </div>
  </section>

  <!-- Forecourts Cards Grid -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-black text-white flex items-center gap-2">
        <span>Stations-Service à {city.name} et aux Alentours</span>
        <span id="stations-count-badge" class="px-2 py-0.5 rounded-full text-xs bg-zinc-800 text-zinc-300">
          Recherche en cours...
        </span>
      </h2>
      <div class="text-xs text-zinc-400">Classées du moins cher au plus cher</div>
    </div>

    <!-- Stations Container Hydrated via Client JS -->
    <div id="stations-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <div class="col-span-full p-8 text-center bg-zinc-900/40 rounded-2xl border border-zinc-800/60">
        <div class="inline-block animate-spin w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full mb-3"></div>
        <div class="text-sm font-semibold text-zinc-300">Chargement des tarifs en direct pour {city.name}...</div>
      </div>
    </div>
  </section>

  <!-- Villes et Communes Voisines (Interlinking SEO) -->
  {nearbyCities.length > 0 && (
    <section class="mb-12">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-2">
              📍 Villes Limitrophes & Alentours
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
              Prix du Carburant dans les Communes Voisines de {city.name}
            </h2>
            <p class="text-xs sm:text-sm text-zinc-400 mt-1">
              Comparez les tarifs de l'essence et du gazole dans un rayon de 10 à 30 km autour de {city.name} :
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {nearbyCities.map((nc) => (
            <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/70 hover:border-blue-500/50 transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <a
                    href={`/prix-carburant/${nc.slug}/`}
                    class="font-bold text-white group-hover:text-blue-400 transition-colors text-sm hover:underline"
                  >
                    {nc.name}
                  </a>
                  <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300">
                    à {nc.distKm.toFixed(1)} km
                  </span>
                </div>
                <div class="text-xs text-zinc-400 mb-3">
                  {nc.deptName} ({nc.deptCode}) • {nc.stationCount} station{nc.stationCount > 1 ? 's' : ''}
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs mb-3">
                  <div class="p-2 rounded-lg bg-zinc-900 border border-zinc-800 text-center">
                    <span class="text-[10px] text-zinc-400 uppercase font-bold block">Gazole dès</span>
                    <span class="font-black text-emerald-400">{nc.minGazole ? `${nc.minGazole.toFixed(3)} €` : '—'}</span>
                  </div>
                  <div class="p-2 rounded-lg bg-zinc-900 border border-zinc-800 text-center">
                    <span class="text-[10px] text-zinc-400 uppercase font-bold block">SP95 dès</span>
                    <span class="font-black text-emerald-400">{nc.minE10 ? `${nc.minE10.toFixed(3)} €` : '—'}</span>
                  </div>
                </div>
              </div>

              <div class="pt-2 border-t border-zinc-800/80 flex items-center justify-between text-[11px] text-zinc-400">
                <a href={`/prix-carburant/${nc.slug}/gazole/`} class="hover:text-blue-400 transition-colors">Gazole</a>
                <span>•</span>
                <a href={`/prix-carburant/${nc.slug}/essence-e10/`} class="hover:text-blue-400 transition-colors">SP95-E10</a>
                <span>•</span>
                <a href={`/prix-carburant/${nc.slug}/sp98/`} class="hover:text-blue-400 transition-colors">SP98</a>
                <span>•</span>
                <a href={`/prix-carburant/${nc.slug}/`} class="text-blue-400 font-semibold hover:underline">Voir tout &rarr;</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Conseils & Tips SEO Économie Carburant -->
  <section class="mb-12">
    <div class="rounded-2xl border border-zinc-800 bg-gradient-to-br from-zinc-900/90 via-zinc-900/50 to-blue-950/20 p-6 sm:p-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xl">💡</span>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-400">Guide Pratique & Économies</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">
        Conseils d'Experts pour Payer Moins Cher son Carburant à {city.name}
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 mb-6 max-w-3xl">
        Entre la station la plus chère et la plus avantageuse à {city.name} ou dans le département {city.deptName}, l'écart peut dépasser 20 centimes par litre, soit plus de 10 € d'économie sur chaque plein de 50 litres. Voici 4 astuces incontournables :
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/60 space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-xs flex items-center justify-center">1</span>
            <h3 class="text-sm font-bold text-white">Privilégiez les Grandes Surfaces (GDO)</h3>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Les stations E.Leclerc, Carrefour, Intermarché et Système U utilisent souvent le carburant comme produit d'appel en vendant à prix coûtant ou avec des marges minimes (1 à 2 centimes/L). Évitez au maximum les stations d'autoroute dont les prix sont majorés de 15 % à 25 %.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/60 space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 font-bold text-xs flex items-center justify-center">2</span>
            <h3 class="text-sm font-bold text-white">Optez pour le SP95-E10 plutôt que le SP98</h3>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            À {city.name}, le SP95-E10 est généralement 8 à 12 centimes moins cher par litre que le SP98. Tous les véhicules essence construits depuis 2000 sont 100 % compatibles, ce qui représente environ 120 à 150 € d'économie sur une année moyenne de roulage.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/60 space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 font-bold text-xs flex items-center justify-center">3</span>
            <h3 class="text-sm font-bold text-white">Vérifiez la Pression des Pneus et Conduisez Souple</h3>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Rouler avec des pneus sous-gonflés de seulement 0,5 bar entraîne une hausse de consommation de 3 % à 5 %. Adopter l'éco-conduite en anticipant les ralentissements et en passant les vitesses à bas régime permet de réduire votre consommation de carburant de 10 % à 15 %.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/60 space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-purple-500/20 text-purple-400 font-bold text-xs flex items-center justify-center">4</span>
            <h3 class="text-sm font-bold text-white">Surveillez les Tendances en Milieu de Semaine</h3>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Les prix des carburants à la pompe connaissent souvent des ajustements avant le week-end. Consulter LeCarbu.fr les mardis et mercredis permet de trouver les prix les plus bas avant les affluences de fins de semaine.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Département & Communes Principales -->
  <section class="mb-12">
    <div class="p-6 sm:p-8 rounded-2xl bg-zinc-900/60 border border-zinc-800">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-zinc-800">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-blue-400 mb-1">
            Département {city.deptName} ({city.deptCode})
          </div>
          <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
            Toutes les stations en {city.deptName}
          </h2>
          <p class="text-xs sm:text-sm text-zinc-400 mt-1">
            Retrouvez le classement officiel des {currentDept?.stationCount || 'nombreuses'} stations du département {city.deptName} ({city.regionName}).
          </p>
        </div>
        <a
          href={`/departement/${deptSlug}/`}
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs bg-blue-600 hover:bg-blue-500 text-white transition-all whitespace-nowrap shadow-md shadow-blue-600/20"
        >
          <span>Voir le département {city.deptCode}</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Principales villes du département -->
      {deptMainCities.length > 0 && (
        <div class="mb-6">
          <div class="text-xs font-bold text-zinc-300 uppercase tracking-wider mb-3">
            Grandes communes en {city.deptName} :
          </div>
          <div class="flex flex-wrap gap-2">
            {deptMainCities.map(dc => (
              <a
                href={`/prix-carburant/${dc.slug}/`}
                class="px-3 py-1.5 rounded-lg text-xs bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 hover:text-blue-400 transition-colors text-zinc-300"
              >
                {dc.name}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Autres départements de la région -->
      {regionDepts.length > 0 && (
        <div class="pt-4 border-t border-zinc-800/80">
          <div class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-3">
            Autres départements en {city.regionName} :
          </div>
          <div class="flex flex-wrap gap-2">
            {regionDepts.map(rd => (
              <a
                href={`/departement/${rd.slug}/`}
                class="px-2.5 py-1 rounded-md text-[11px] bg-zinc-950 border border-zinc-800/70 hover:border-zinc-600 text-zinc-400 hover:text-white transition-colors"
              >
                {rd.name} ({rd.code})
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Marques & Enseignes à cette commune -->
  <section class="mb-12">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <h2 class="text-base font-bold text-white mb-2">
        Rechercher par Enseigne à {city.name}
      </h2>
      <p class="text-xs text-zinc-400 mb-4">
        Consultez les prix par marque de distributeur à {city.name} et dans ses environs :
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {(brandsData as any[]).map(b => (
          <a
            href={`/enseigne/${b.slug}/${city.slug}/`}
            class="p-2.5 rounded-xl border border-zinc-800 bg-zinc-950/60 hover:border-blue-500/40 text-center transition-all group"
          >
            <span class="block text-xs font-bold text-zinc-200 group-hover:text-blue-400">{b.name}</span>
            <span class="text-[10px] text-zinc-400">{b.category}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad Slot Middle -->
  <AdSlot />

  <!-- Local FAQ & SEO Content -->
  <section class="mt-12 rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 sm:p-8">
    <h2 class="text-xl font-black text-white mb-6">
      Foire Aux Questions — Carburant à {city.name}
    </h2>
    <div class="space-y-6 text-sm">
      <div class="border-b border-zinc-800/80 pb-4">
        <h3 class="font-bold text-white text-base mb-1">
          Où trouver le carburant le moins cher à {city.name} ?
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          Les stations des grandes surfaces (E.Leclerc, Carrefour, Intermarché, Système U, Auchan) ainsi que les stations Total Access proposent généralement les prix les plus bas à {city.name}. Consultez notre tableau comparatif ci-dessus mis à jour en continu via le flux officiel de l'État pour repérer la station avec le badge vert « LE MOINS CHER ».
        </p>
      </div>

      <div class="border-b border-zinc-800/80 pb-4">
        <h3 class="font-bold text-white text-base mb-1">
          Quelle est la différence entre le SP95-E10 et le SP98 à {city.name} ?
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          Le SP95-E10 contient jusqu'à 10 % de bioéthanol et convient à la quasi-totalité des véhicules essence immatriculés depuis 2000. Le SP98 (Super sans plomb 98) offre un indice d'octane plus élevé favorisant la protection et les performances des moteurs sportifs ou anciens, avec un surcoût moyen de 8 à 12 centimes par litre.
        </p>
      </div>

      <div>
        <h3 class="font-bold text-white text-base mb-1">
          À quelle fréquence les prix des carburants sont-ils actualisés ?
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          En France, la loi oblige tous les gérants de stations distribuant plus de 500 m³ de carburant par an à déclarer tout changement de tarif immédiatement sur la plateforme gouvernementale du Ministère de l'Économie. LeCarbu.fr synchronise ces données quotidiennement pour vous garantir une information fiable.
        </p>
      </div>
    </div>
  </section>
</div>

<!-- Client-side hydration script for Map and Stations List -->
<script is:inline define:vars={{ cityLat: city.lat, cityLng: city.lng, citySlug: city.slug, targetFuel: fuelFilter }}>
  (async function () {
    const listContainer = document.getElementById('stations-list');
    const countBadge = document.getElementById('stations-count-badge');
    const mapEl = document.getElementById('city-map');

    if (!listContainer || !mapEl) return;

    try {
      const res = await fetch('/fr_stations_index.json');
      const allStations = await res.json();

      function getDist(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      }

      // Filter stations within 25km of city center
      let nearby = allStations
        .map(s => ({ ...s, dist: getDist(cityLat, cityLng, s.lt, s.lg) }))
        .filter(s => s.dist <= 25);

      if (nearby.length === 0) {
        nearby = allStations
          .map(s => ({ ...s, dist: getDist(cityLat, cityLng, s.lt, s.lg) }))
          .sort((a,b) => a.dist - b.dist)
          .slice(0, 10);
      }

      // Sort by targeted fuel lowest price, then by distance
      nearby.sort((a, b) => {
        let pA = 999;
        let pB = 999;
        if (targetFuel === 'gazole') {
          pA = a.p.g || 999;
          pB = b.p.g || 999;
        } else if (targetFuel === 'e10') {
          pA = a.p.e || 999;
          pB = b.p.e || 999;
        } else if (targetFuel === 'sp98') {
          pA = a.p.s || 999;
          pB = b.p.s || 999;
        } else if (targetFuel === 'e85') {
          pA = a.p.e85 || 999;
          pB = b.p.e85 || 999;
        } else {
          // Default: compare minimum of available main fuels
          pA = Math.min(a.p.g || 999, a.p.e || 999);
          pB = Math.min(b.p.g || 999, b.p.e || 999);
        }
        if (pA !== pB) return pA - pB;
        return a.dist - b.dist;
      });

      countBadge.textContent = `${nearby.length} station${nearby.length > 1 ? 's' : ''} à proximité`;

      // Render Forecourt Cards
      listContainer.innerHTML = nearby.map((s, idx) => {
        const isCheapest = idx === 0;
        const gPrice = s.p.g ? `${s.p.g.toFixed(3)} €` : '—';
        const ePrice = s.p.e ? `${s.p.e.toFixed(3)} €` : '—';
        const sPrice = s.p.s ? `${s.p.s.toFixed(3)} €` : '—';
        const e85Price = s.p.e85 ? `${s.p.e85.toFixed(3)} €` : null;

        return `
          <article class="p-5 rounded-2xl border ${isCheapest ? 'border-emerald-500/60 bg-gradient-to-b from-emerald-950/20 to-zinc-900/90 shadow-lg shadow-emerald-500/10' : 'border-zinc-800 bg-zinc-900/70'} flex flex-col justify-between transition-all hover:border-zinc-700">
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-zinc-800 text-zinc-300">
                  ${s.b.toUpperCase()}
                </span>
                ${isCheapest ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-black uppercase tracking-wider bg-emerald-500 text-black shadow-sm">LE MOINS CHER</span>' : `<span class="text-xs text-zinc-400 font-medium">${s.dist.toFixed(1)} km</span>`}
              </div>
              <h3 class="text-base font-bold text-white leading-snug mb-1">${s.n}</h3>
              <p class="text-xs text-zinc-400 mb-4">${s.a}, ${s.cp} ${s.v}</p>

              <!-- Fuel Prices Grid -->
              <div class="grid grid-cols-3 gap-2 mb-4">
                <div class="p-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80 text-center">
                  <div class="text-[9px] uppercase font-bold text-zinc-400">Gazole</div>
                  <div class="text-sm font-black ${s.p.g ? (isCheapest ? 'text-emerald-400' : 'text-zinc-100') : 'text-zinc-600'}">${gPrice}</div>
                </div>
                <div class="p-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80 text-center">
                  <div class="text-[9px] uppercase font-bold text-zinc-400">SP95-E10</div>
                  <div class="text-sm font-black ${s.p.e ? (isCheapest ? 'text-emerald-400' : 'text-zinc-100') : 'text-zinc-600'}">${ePrice}</div>
                </div>
                <div class="p-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80 text-center">
                  <div class="text-[9px] uppercase font-bold text-zinc-400">SP98</div>
                  <div class="text-sm font-black ${s.p.s ? 'text-blue-400' : 'text-zinc-600'}">${sPrice}</div>
                </div>
              </div>
              ${e85Price ? `
                <div class="mb-4 p-1.5 rounded-lg bg-emerald-950/40 border border-emerald-900/60 flex items-center justify-between text-xs px-3">
                  <span class="text-emerald-300 font-semibold text-[11px]">Superéthanol E85</span>
                  <span class="font-black text-emerald-400">${e85Price}</span>
                </div>
              ` : ''}
            </div>

            <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between gap-3 text-xs">
              <span class="text-[11px] text-zinc-400">
                ${s.aut ? '⚡ Automate 24/24' : '🕒 Ouvert'}
              </span>
              <a
                href="https://www.google.com/maps/dir/?api=1&destination=${s.lt},${s.lg}"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 font-semibold text-blue-400 hover:text-blue-300 transition-colors"
              >
                <span>Y aller</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </article>
        `;
      }).join('');

      // Initialize Leaflet Map
      if (typeof window.L !== 'undefined') {
        const map = window.L.map('city-map', { scrollWheelZoom: false }).setView([cityLat, cityLng], 12);
        window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
        }).addTo(map);

        nearby.forEach((s, i) => {
          let priceTag = s.p.g ? `${s.p.g.toFixed(2)}€` : (s.p.e ? `${s.p.e.toFixed(2)}€` : 'Carbu');
          const isCheapest = i === 0;

          const icon = window.L.divIcon({
            className: 'custom-map-pin',
            html: `<div class="custom-price-pin ${isCheapest ? 'cheapest' : ''}">${priceTag}</div>`,
            iconSize: [45, 20],
            iconAnchor: [22, 10]
          });

          window.L.marker([s.lt, s.lg], { icon })
            .addTo(map)
            .bindPopup(`
              <div style="font-family: system-ui, -apple-system, sans-serif; font-size: 12px; color: #f4f4f5; padding: 2px;">
                <b style="font-size: 13px; color: #ffffff;">${s.n}</b><br/>
                <span style="color: #a1a1aa;">${s.a}, ${s.v}</span><br/>
                <hr style="margin: 6px 0; border: none; border-top: 1px solid #27272a;"/>
                <div style="line-height: 1.5;">
                  <b>Gazole:</b> ${s.p.g ? s.p.g.toFixed(3) + ' €' : 'N/A'}<br/>
                  <b>SP95-E10:</b> ${s.p.e ? s.p.e.toFixed(3) + ' €' : 'N/A'}<br/>
                  <b>SP98:</b> ${s.p.s ? s.p.s.toFixed(3) + ' €' : 'N/A'}
                </div>
                <a href="https://www.google.com/maps/dir/?api=1&destination=${s.lt},${s.lg}" target="_blank" rel="noopener" style="display: inline-block; margin-top: 8px; font-size: 11px; font-weight: bold; background: #2563eb; color: #ffffff; padding: 4px 10px; border-radius: 6px; text-decoration: none;">
                  Itinéraire GPS &rarr;
                </a>
              </div>
            `);
        });
      }
    } catch (err) {
      console.error(err);
      listContainer.innerHTML = '<div class="col-span-full p-4 text-center text-red-400">Erreur de chargement des données. Veuillez réessayer.</div>';
    }
  })();
</script>
