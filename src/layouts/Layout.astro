---
import '../styles/global.css';

/**
 * Layout.astro — LeCarbu.fr
 * Base layout with French tricolor branding, UniConsent CMP, Google Consent Mode v2,
 * AdSense ca-pub-2168172914069272, and French SEO metadata.
 */
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  schema,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical.endsWith('/') ? canonical : `${canonical}/`;
---

<!DOCTYPE html>
<html lang="fr-FR" class="dark scroll-smooth selection:bg-blue-600 selection:text-white">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large" />
  )}
  <meta name="google-adsense-account" content="ca-pub-2168172914069272" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="LeCarbu.fr" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:image" content="https://lecarbu.fr/og-image.png" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://lecarbu.fr/og-image.png" />

  <!-- Mobile Theme -->
  <meta name="theme-color" content="#09090b" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Leaflet CSS & JS for Interactive Map -->
  <link rel="stylesheet" href="/leaflet/leaflet.css" />
  <script src="/leaflet/leaflet.js" is:inline></script>

  <!-- DNS prefetch for speed -->
  <link rel="dns-prefetch" href="https://cmp.uniconsent.com" />
  <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />

  <!-- Google Consent Mode v2 (default denial before CMP & Ads) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
  </script>

  <!-- UniConsent CMP (Consent Management Platform IAB TCF v2.2 & CNIL / RGPD) -->
  <script
    async
    fetchpriority="low"
    src="https://cmp.uniconsent.com/v2/cmp.js"
    data-license="e538d9903a"
  ></script>

  <!-- Google AdSense (Auto Ads & Custom Units) -->
  <script
    async
    fetchpriority="low"
    crossorigin="anonymous"
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2168172914069272"
  ></script>

  <!-- Schema.org Structured Data -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- Theme Initializer & Global Toggle (Solar / Dark Mode) -->
  <script is:inline>
    (function() {
      const storedTheme = localStorage.getItem('lc_theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (storedTheme === 'light' || (!storedTheme && !prefersDark)) {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();

    window.toggleTheme = function() {
      const isDark = document.documentElement.classList.toggle('dark');
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
      localStorage.setItem('lc_theme', isDark ? 'dark' : 'light');
      window.dispatchEvent(new CustomEvent('lc_theme_changed', { detail: { isDark } }));
    };
  </script>
</head>
<body class="min-h-screen flex flex-col bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased transition-colors duration-150">
  <!-- French Tricolor Thin Accent Line -->
  <div class="french-tricolor-line w-full"></div>

  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-zinc-200 dark:border-zinc-800/80 bg-white/95 dark:bg-zinc-950/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <!-- Logo with French Flag Accents -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-red-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform p-0.5">
          <div class="w-full h-full bg-zinc-950 rounded-[10px] flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 7h-1V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v18h10V11h1a2 2 0 0 0 2-2V7zm-9 6H8v-2h2v2zm0-4H8V7h2v2zm6 4h-2v-2h2v2zm0-4h-2V7h2v2zm4 4h-1V9h1v4zM5 19H3v-7a3 3 0 0 1 3-3v2a1 1 0 0 0-1 1v7z"/>
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl font-black tracking-tight text-zinc-900 dark:text-white">
              Le<span class="text-blue-500">Carbu</span><span class="text-zinc-400 dark:text-zinc-500 text-sm font-semibold">.fr</span>
            </span>
            <!-- French mini-pill -->
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60">
              🇫🇷 DIRECT
            </span>
          </div>
          <span class="text-[9px] text-zinc-500 dark:text-zinc-400 font-semibold tracking-wider uppercase -mt-1">
            Prix des Carburants en Temps Réel
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-5 text-sm font-medium">
        <a href="/prix-carburant/gazole/" class="text-zinc-600 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Gazole</a>
        <a href="/prix-carburant/essence-e10/" class="text-zinc-600 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">SP95-E10</a>
        <a href="/prix-carburant/sp98/" class="text-zinc-600 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">SP98</a>
        <a href="/prix-carburant/e85/" class="text-emerald-700 dark:text-emerald-400 hover:text-emerald-600 dark:hover:text-emerald-300 transition-colors font-semibold">E85 Bioéthanol</a>
        <a href="/supermarche-carburant/" class="text-zinc-600 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Supermarchés</a>
        <a href="/carburant-moins-cher/" class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold hover:from-blue-500 hover:to-indigo-500 transition-all shadow-md shadow-blue-500/20 text-xs">
          Le Moins Cher
        </a>
      </nav>

      <!-- Search Trigger / Quick Action & Solar Mode Toggle -->
      <div class="flex items-center gap-2.5">
        <a
          href="/#search-container"
          class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 text-xs text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:border-zinc-400 dark:hover:border-zinc-700 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Rechercher une ville ou code postal...</span>
        </a>

        <!-- Solar / Dark Mode Button -->
        <button
          id="theme-toggle"
          type="button"
          onclick="window.toggleTheme()"
          aria-label="Mode Solaire / Sombre"
          title="Changer de thème (Mode Solaire / Sombre)"
          class="p-2 rounded-xl text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-800 border border-zinc-300 dark:border-zinc-800 transition-colors cursor-pointer"
        >
          <!-- Sun icon (shown in dark mode -> click to activate Solar mode) -->
          <svg id="sun-icon" class="w-4 h-4 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
          </svg>
          <!-- Moon icon (shown in light mode -> click to activate Dark mode) -->
          <svg id="moon-icon" class="w-4 h-4 block dark:hidden text-zinc-700" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Slot -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-16 border-t border-zinc-900 bg-zinc-950/80 text-zinc-400 text-xs">
    <div class="french-tricolor-line w-full"></div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <!-- Col 1: About -->
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-base font-black text-white">
              Le<span class="text-blue-500">Carbu</span><span class="text-zinc-500 font-semibold">.fr</span>
            </span>
            <span class="text-[10px] bg-red-950 text-red-300 px-1.5 py-0.5 rounded border border-red-800">
              Open Data
            </span>
          </div>
          <p class="text-zinc-400 leading-relaxed text-[11px]">
            Comparateur indépendant des prix des carburants en France métropolitaine. Alimenté en direct par le flux officiel du Ministère de l'Économie, des Finances et de la Souveraineté industrielle (prix-carburants.gouv.fr / roulez-eco.fr).
          </p>
          <div class="text-[11px] text-zinc-500">
            Mise à jour automatique quotidienne à 02:30.
          </div>
        </div>

        <!-- Col 2: Carburants -->
        <div>
          <div class="font-bold text-white mb-3 uppercase tracking-wider text-[11px]">Carburants</div>
          <ul class="space-y-2 text-[12px]">
            <li><a href="/prix-carburant/gazole/" class="hover:text-blue-400 transition-colors">Prix Gazole (Diesel B7)</a></li>
            <li><a href="/prix-carburant/essence-e10/" class="hover:text-blue-400 transition-colors">Prix SP95-E10 (Essence)</a></li>
            <li><a href="/prix-carburant/sp98/" class="hover:text-blue-400 transition-colors">Prix SP98 (Super sans plomb)</a></li>
            <li><a href="/prix-carburant/e85/" class="hover:text-emerald-400 transition-colors">Prix E85 (Superéthanol bio)</a></li>
            <li><a href="/carburant-moins-cher/" class="hover:text-blue-400 transition-colors">Top Stations les Moins Chères</a></li>
          </ul>
        </div>

        <!-- Col 3: Enseignes & Grandes Surfaces -->
        <div>
          <div class="font-bold text-white mb-3 uppercase tracking-wider text-[11px]">Enseignes & Réseaux</div>
          <ul class="space-y-2 text-[12px]">
            <li><a href="/enseigne/leclerc/" class="hover:text-blue-400 transition-colors">E.Leclerc Carburant</a></li>
            <li><a href="/enseigne/totalenergies/" class="hover:text-blue-400 transition-colors">TotalEnergies & Total Access</a></li>
            <li><a href="/enseigne/carrefour/" class="hover:text-blue-400 transition-colors">Carrefour Station</a></li>
            <li><a href="/enseigne/intermarche/" class="hover:text-blue-400 transition-colors">Intermarché Carburant</a></li>
            <li><a href="/enseigne/systeme-u/" class="hover:text-blue-400 transition-colors">Système U / Super U</a></li>
            <li><a href="/enseigne/auchan/" class="hover:text-blue-400 transition-colors">Auchan Carburant</a></li>
          </ul>
        </div>

        <!-- Col 4: Mentions & Conformité -->
        <div>
          <div class="font-bold text-white mb-3 uppercase tracking-wider text-[11px]">Légal & Vie Privée</div>
          <ul class="space-y-2 text-[12px]">
            <li><a href="/mentions-legales/" class="hover:text-blue-400 transition-colors">Mentions Légales</a></li>
            <li><a href="/politique-de-confidentialite/" class="hover:text-blue-400 transition-colors">Politique de Confidentialité (RGPD)</a></li>
            <li><a href="/politique-cookies/" class="hover:text-blue-400 transition-colors">Politique des Cookies</a></li>
            <li>
              <a
                href="#uniconsent-open"
                onclick="if(window.__cmp){window.__cmp('showConsentTool'); return false;}"
                class="hover:text-blue-400 transition-colors underline cursor-pointer"
              >
                Gérer les préférences de cookies
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="pt-8 border-t border-zinc-900/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-zinc-400">
        <div>
          &copy; {new Date().getFullYear()} <span class="text-white font-semibold">LeCarbu.fr</span>. Tous droits réservés. Données ouvertes soumises à la Licence Ouverte v2.0 (Etalab).
        </div>
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 text-zinc-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            9 820 stations suivies en direct
          </span>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
